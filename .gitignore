# Personal, per-machine Claude Code settings
.claude/settings.local.json
.claude/logs/

# Terraform — state contains plaintext secrets, never commit it
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
tfplan
crash.log
*.auto.tfvars
!example.auto.tfvars

# Node
node_modules/
dist/
build/
*.tsbuildinfo
.npm/

# Go
*.test
*.out
vendor/

# Swift / Xcode
.build/
DerivedData/
*.xcuserstate
xcuserdata/
.swiftpm/

# Secrets — never commit
.env
.env.*
!.env.example
*.pem
*.key
credentials

# OS / editor
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Python
__pycache__/
*.pyc

# Feature specs are working output, not part of the template.
# The empty directory ships so the workflow has somewhere to write.
.claude/specs/*
!.claude/specs/.gitkeep
